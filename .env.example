# Copy to .env and edit. .env is gitignored — never commit real values.
# All backend settings are prefixed ABSA_.

# Where model artefacts are loaded from.
ABSA_MODELS_DIR=./models

# auto | baseline | transformer
#   auto -> follow models/metadata/comparison.json, which is written from
#           held-out test metrics. Each stage resolves independently.
ABSA_PREDICTOR=auto

# Per-stage overrides (auto | baseline | transformer).
# The objective comparison selected different families per stage:
#   aspect detection -> TF-IDF   (micro F1 0.7755 vs DistilBERT 0.6192)
#   sentiment        -> DistilBERT (macro F1 0.6538 vs TF-IDF 0.6088)
#
# Set ABSA_SENTIMENT_MODEL=baseline to trade 4.5 points of macro F1 for
# better-calibrated confidence: DistilBERT is confidently wrong on 30.1% of
# mixed reviews versus the baseline's 17.7%. See docs/model.md.
# ABSA_ASPECT_MODEL=auto
# ABSA_SENTIMENT_MODEL=auto

# Torch device override, e.g. cpu or cuda. Leave unset to auto-detect.
# ABSA_DEVICE=cpu

# Comma-separated allowed browser origins for CORS.
ABSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request guardrails.
ABSA_MAX_REVIEW_CHARS=5000
ABSA_MAX_BATCH_SIZE=500

ABSA_DEBUG=false

# ---------------------------------------------------------------------------
# Training only — never needed by the API, never committed.
# In Colab use the secrets panel (key icon) rather than a .env file.
# ---------------------------------------------------------------------------
# HF_TOKEN=
