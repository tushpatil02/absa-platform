# Copy to .env and edit. .env is gitignored — never commit real values.
# All backend settings are prefixed ABSA_.

# Where model artefacts are loaded from.
ABSA_MODELS_DIR=./models

# auto | baseline | transformer
#   auto -> use a fine-tuned transformer if present, else the TF-IDF baseline.
ABSA_PREDICTOR=auto

# Torch device override, e.g. cpu or cuda. Leave unset to auto-detect.
# ABSA_DEVICE=cpu

# Comma-separated allowed browser origins for CORS.
ABSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request guardrails.
ABSA_MAX_REVIEW_CHARS=5000
ABSA_MAX_BATCH_SIZE=500

ABSA_DEBUG=false

# ---------------------------------------------------------------------------
# Training only — never needed by the API, never committed.
# In Colab use the secrets panel (key icon) rather than a .env file.
# ---------------------------------------------------------------------------
# HF_TOKEN=
