.git/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Training-only material — never needed to serve.
data/
notebooks/
tests/
docs/
scripts/
frontend/

# ...except the built catalogue, which the API serves. Three small files;
# the ~45 MB review_aspects.csv they were distilled from stays excluded.
!data/catalog/
!data/catalog/*.csv
!data/catalog/*.json

# Large weights are pulled at deploy time, not baked into the image.
models/**/*.safetensors
models/**/*.bin
models/**/*.onnx

.env
*.md
