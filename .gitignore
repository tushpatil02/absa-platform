# ---------------------------------------------------------------------------
# Secrets  (never commit -- see docs/security.md)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
kaggle.json

# ---------------------------------------------------------------------------
# Data
# Raw data is fetched by scripts/download_data.py, never committed:
# M-ABSA ships no LICENSE, so we do not redistribute it.
# ---------------------------------------------------------------------------
data/raw/
data/processed/
data/interim/
*.csv
*.tsv
*.parquet

# ...but the built catalogue is the product, not an intermediate. Three small
# files (~500 KB) that let a clone run the app without an hour of CPU inference.
# The 45 MB review_aspects.csv they were distilled from stays ignored.
!data/catalog/
!data/catalog/*.csv
!data/catalog/*.json
!data/**/CITATION.bib
!tests/fixtures/*.csv

# ---------------------------------------------------------------------------
# Model artifacts
# Trained weights live on the Hugging Face Hub, not in git.
# Only metadata (metrics, label maps, model cards) is versioned.
# ---------------------------------------------------------------------------
# Promotion keeps the prior checkpoint as <stage>.previous/ for rollback;
# those are large and local-only.
models/*.previous/
models/*.rolledback/

# Everything under models/ is ignored by default, then a short allow-list
# re-includes the small human-readable descriptors. Order matters: in gitignore
# the LAST matching pattern wins, so a blanket "!models/**/*.json" here would
# undo the tokenizer.json exclusion below.
models/**
!models/
!models/*/
!models/metadata/
!models/**/metadata.json
!models/**/config.json
!models/**/tokenizer_config.json
!models/metadata/*.json
!models/**/*.md

# The two baseline artefacts ARE committed, unlike the transformer weights.
# They are 3.9 MB of deterministic scikit-learn, not 268 MB of safetensors, and
# without them a clean checkout has no model at all: every inference route 503s
# while the container still builds green and reports healthy. That failure looks
# like a CORS or platform problem and is neither.
!models/baseline_aspect_detector/model.joblib
!models/baseline_sentiment_classifier/model.joblib

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# ---------------------------------------------------------------------------
# Notebooks -- strip outputs before committing (nbstripout recommended)
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
notebooks/**/outputs/

# Colab runtime leftovers
sample_data/
drive/
adc.json

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local editor/agent tooling — machine-specific paths, not project config.
.claude/
